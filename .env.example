# Application database. Unit tests use this same database and truncate it after each test.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Static key every /api/v1 request sends in X-API-Key. At least 16 characters.
API_KEY=dev-only-api-key-change-me

ENVIRONMENT=local
LOG_LEVEL=INFO
DB_ECHO=false

# Outbox relay: how often to poll the outbox table and how many rows to publish at once.
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Gateway emulation: processing takes a random delay, success_rate share succeeds.
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

# Consumer retries: total attempts before the dead letter queue and the first delay.
# Delays grow as base * 2^(n-1): 2s, 4s for the defaults.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
WEBHOOK_TIMEOUT=10
